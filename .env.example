# ==========================================
# DIVULGADOR INTELIGENTE - CONFIGURAÇÕES
# Copie este arquivo para .env e preencha
# ==========================================

# Token do BotFather do Telegram
TELEGRAM_BOT_TOKEN=

# IDs dos grupos/canais onde o bot vai postar (separados por vírgula)
TELEGRAM_CHAT_IDS=

# Seu ID pessoal do Telegram (pra receber comandos)
TELEGRAM_ADMIN_ID=

# Chave da API Shopee de Afiliados
SHOPEE_APP_ID=
SHOPEE_SECRET_KEY=

# OpenAI para gerar textos de vendas com IA
OPENAI_API_KEY=

# Bitly (opcional - pra encurtar links)
BITLY_TOKEN=

# Banco de dados
DATABASE_URL=sqlite:///./divulgador.db

# Horários de disparo automático (formato 24h, separados por vírgula)
POST_SCHEDULE=09:00,12:00,15:00,18:00,21:00

# URL do seu site (depois de hospedar)
SITE_URL=http://localhost:8000
